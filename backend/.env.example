# ==============================================================================
# AuditIQ Backend Configuration
# ==============================================================================
# Copy this file to .env in this folder (backend/.env) and populate the values.
# NEVER commit your actual .env file with real credentials to GitHub.

# --- AI & LLM Provider API Keys ---
# Groq API Key (Required for AI Audit Report and NL Query Assistant)
# Obtain your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# xAI (Grok) API Key (Optional)
XAI_API_KEY=your_xai_api_key_here

# OpenAI API Key (Optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# --- Server Configuration ---
HOST=0.0.0.0
PORT=8000
