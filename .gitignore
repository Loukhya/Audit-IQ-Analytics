# ==============================================================================
# AuditIQ .gitignore
# ==============================================================================

# --- Python & Virtual Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
env/
ENV/
.venv/
env.bak/
venv.bak/

# --- Testing & Coverage ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Node.js & Frontend Tooling ---
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
vite_error.log
*.log

# --- Environment & Secrets ---
# Never commit credentials or secrets to version control
.env
.env.*
!.env.example
*.pem
*.key

# --- Application Cache & Dynamic Data ---
backend/cache/*.json
!backend/cache/.gitkeep
backend/data/
data/
*.csv
*.xlsx
*.tsv
*.parquet
.pen

# --- IDE & Editor Artifacts ---
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*~

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
